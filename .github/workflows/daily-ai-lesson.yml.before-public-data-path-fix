name: VIDHWAAN NEET — Daily AI Lesson

on:
  schedule:
    - cron: "30 19 * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: vidhwaan-neet-daily-generation
  cancel-in-progress: false

jobs:
  generate:
    name: Generate Exactly One Daily Lesson
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Validate syllabus
        run: npm run validate

      - name: Validate Groq secret
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        run: |
          if [ -z "$GROQ_API_KEY" ]; then
            echo "GROQ_API_KEY GitHub Secret is missing."
            exit 1
          fi

          case "$GROQ_API_KEY" in
            gsk_*) echo "GROQ_API_KEY configured." ;;
            *) echo "Unexpected Groq key format."; exit 1 ;;
          esac

      - name: Generate exactly one next day
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GROQ_MODEL: openai/gpt-oss-120b
        run: node generator/generate-day.js

      - name: Validate lesson sequence
        run: |
          python3 - <<'PY'
          import json
          import re
          from pathlib import Path

          files = sorted(
              Path("data").glob("day-*.json"),
              key=lambda p: int(p.stem.split("-")[1])
          )

          if len(files) > 365:
              raise SystemExit("More than 365 lesson files exist.")

          expected = 1

          for f in files:
              m = re.fullmatch(r"day-(\d{3})", f.stem)
              if not m:
                  raise SystemExit(f"Invalid lesson filename: {f.name}")

              day = int(m.group(1))

              if day != expected:
                  raise SystemExit(
                      f"Sequence broken: expected Day {expected}, found Day {day}"
                  )

              content = json.loads(f.read_text())

              if int(content.get("day", 0)) != day:
                  raise SystemExit(f"{f}: day metadata mismatch")

              if not content.get("courseDate"):
                  raise SystemExit(f"{f}: missing courseDate")

              if not content.get("publishAt"):
                  raise SystemExit(f"{f}: missing publishAt")

              expected += 1

          print(f"Lesson files: {len(files)}")
          print("Lesson sequence: VALID")
          PY

      - name: Commit generated lesson
        run: |
          git add data/day-*.json

          if git diff --cached --quiet; then
            echo "No new lesson generated."
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git commit -m "chore: generate daily NEET lesson"
          git push

          echo "Daily lesson committed and pushed."

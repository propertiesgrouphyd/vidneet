<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover"
    >

    <meta
        name="theme-color"
        content="#ffffff"
    >

    <meta
        name="description"
        content="Vidhwaan NEET — 365-Day NEET Preparation"
    >

    <meta
        name="mobile-web-app-capable"
        content="yes"
    >

    <meta
        name="apple-mobile-web-app-capable"
        content="yes"
    >

    <meta
        name="apple-mobile-web-app-status-bar-style"
        content="default"
    >

    <meta
        name="apple-mobile-web-app-title"
        content="Vidhwaan NEET"
    >

    <title>Vidhwaan NEET</title>

    <link rel="icon" href="./icons/favicon.ico">

    <link
        rel="apple-touch-icon"
        href="./icons/icons-198.png"
    >

    <link
        rel="manifest"
        href="./manifest.json"
    >

    <link
        rel="stylesheet"
        href="./css/main.css"
    >
</head>

<body>

<div class="app-shell">

    <!-- ======================================================
         NAVBAR
         ====================================================== -->
    <header class="topbar">

        <div class="topbar-inner">

            <a
                href="./"
                class="brand"
                aria-label="Vidhwaan NEET Home"
            >
                <div class="brand-logo">
                    <img
                        src="./icons/logo.png"
                        alt="Vidhwaan"
                    >
                </div>

                <div class="brand-text">
                    <div class="brand-name">VIDHWAAN NEET</div>
                    <div class="brand-tagline">
                        365-Day NEET Preparation
                    </div>
                </div>
            </a>

            <div
                id="release-status"
                class="release-status"
            >
                <span class="status-dot"></span>
                <span id="release-status-text">
                    Checking today's lesson…
                </span>
            </div>

        </div>

    </header>


    <!-- ======================================================
         MAIN
         ====================================================== -->
    <main class="main-content">

        <!-- HERO -->
        <section class="hero-card">

            <div class="hero-content">

                <div class="eyebrow">
                    VIDHWAAN • NEET PREPARATION
                </div>

                <h1>
                    Master NEET<br>
                    <span>One Day at a Time.</span>
                </h1>

                <p>
                    Learn every concept clearly, strengthen it with
                    NEET-style practice, and progress through the
                    complete 365-day syllabus step by step.
                </p>

            </div>

            <div class="hero-mark" aria-hidden="true">
                <div class="hero-ring hero-ring-one"></div>
                <div class="hero-ring hero-ring-two"></div>
                <div class="hero-ring hero-ring-three"></div>
                <div class="hero-gold-dot"></div>
            </div>

        </section>


        <!-- RELEASE HEADER -->
        <section class="section-heading">

            <div>
                <h2>365-Day Syllabus</h2>

                <p id="syllabus-summary">
                    Preparing your daily NEET journey…
                </p>
            </div>

            <div
                id="today-badge"
                class="today-badge"
            >
                <span class="today-badge-dot"></span>
                <span id="today-badge-text">Loading</span>
            </div>

        </section>


        <!-- DAY GRID -->
        <section
            id="day-grid"
            class="day-grid"
            aria-label="365-Day NEET syllabus"
        >
            <!-- Generated by app.js -->
        </section>


        <!-- LOADING -->
        <div
            id="loading-state"
            class="loading-state"
        >
            <div class="loading-spinner"></div>
            <p>Loading syllabus…</p>
        </div>


        <!-- ERROR -->
        <div
            id="error-state"
            class="error-state hidden"
        >
            <div class="error-icon">!</div>

            <h3>Unable to load the syllabus</h3>

            <p id="error-message">
                Please check your connection and try again.
            </p>

            <button
                id="retry-button"
                class="gold-button"
                type="button"
            >
                Try Again
            </button>
        </div>

    </main>


    <!-- ======================================================
         FOOTER
         ====================================================== -->
    <footer class="footer">

        <div class="footer-inner">

            <div class="footer-brand">
                <img
                    src="./icons/logo.png"
                    alt="Vidhwaan"
                >

                <div>
                    <strong>VIDHWAAN NEET</strong>
                    <span>365-Day NEET Preparation</span>
                </div>
            </div>

            <div class="footer-copy">
                © VIDHWAAN
            </div>

        </div>

    </footer>

</div>


<!-- ==========================================================
     PWA INSTALL FLOATING BUTTON
     ========================================================== -->
<button
    id="install-button"
    class="install-button hidden"
    type="button"
    aria-label="Install Vidhwaan NEET"
>
    <span class="install-icon">↓</span>

    <span class="install-text">
        Install App
    </span>
</button>


<script
    type="module"
    src="./js/app.js"
></script>

</body>
</html>
